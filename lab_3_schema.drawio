        <mxCell id="input" value="Ввести price" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=20;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Arial;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="230" y="130" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="save" value="original_price = price" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Arial;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="210" y="220" width="180" height="50" as="geometry"/>
